# Local secrets for `npm run preview:cf` (wrangler pages dev).
# Copy to .dev.vars (gitignored). These test keys are Cloudflare's public
# Turnstile test values; swap in real keys only on your own machine.

# Turnstile test secret that always passes. (2x0000000000000000000000000000000AA always fails.)
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Real Resend key to actually send email locally, from https://resend.com/api-keys
RESEND_API_KEY=""

CONTACT_TO_EMAIL="brightstack.pk@gmail.com"
# Before your domain is verified in Resend, use: "Brightstack <onboarding@resend.dev>"
# (Resend only delivers that to the email address your Resend account uses.)
CONTACT_FROM_EMAIL="Brightstack Website <website@brightstack.pk>"
