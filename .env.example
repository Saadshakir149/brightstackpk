# Brightstack environment variables.
# Copy to .env for local builds. NEVER commit real values: .env is gitignored.
# In production, set these in Vercel > Project > Settings > Environment Variables
# (full walkthrough in README.md, "Contact form setup").

# ---------------------------------------------------------------
# Build-time (public). Baked into the HTML; safe to expose.
# ---------------------------------------------------------------

# Cloudflare Turnstile SITE key (public). Until it's set, the contact page shows
# WhatsApp + email instead of the form. For local testing use Cloudflare's
# always-passes test key: 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=""

# Optional overrides. Leave commented out to use the defaults in src/config.ts.
# PUBLIC_SITE_URL="https://brightstack.pk"
# PUBLIC_WHATSAPP_NUMBER="923064840980"
# PUBLIC_CONTACT_EMAIL="brightstack.pk@gmail.com"

# ---------------------------------------------------------------
# Runtime secrets for the Vercel Function (api/contact.ts).
# Set these in the Vercel dashboard (mark the keys as "Sensitive").
# For local testing: `vercel env pull` then `vercel dev`.
# ---------------------------------------------------------------
# TURNSTILE_SECRET_KEY=""
# RESEND_API_KEY=""
# CONTACT_TO_EMAIL="brightstack.pk@gmail.com"
# CONTACT_FROM_EMAIL="Brightstack Website <website@brightstack.pk>"
