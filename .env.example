# Brightstack environment variables.
# Copy to .env for local builds. NEVER commit real values: .env is gitignored.
# In production, set these in Cloudflare Pages > Settings > Variables and Secrets
# (full walkthrough in README.md, "Contact form setup").

# ---------------------------------------------------------------
# Build-time (public). Baked into the HTML; safe to expose.
# ---------------------------------------------------------------

# Cloudflare Turnstile SITE key (public). REQUIRED: the build fails without it,
# so a broken contact form can never be deployed. For local testing use
# Cloudflare's always-passes test key: 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=""

# Optional overrides. Leave commented out to use the defaults in src/config.ts.
# PUBLIC_SITE_URL="https://brightstack.pk"
# PUBLIC_WHATSAPP_NUMBER="923064840980"
# PUBLIC_CONTACT_EMAIL="brightstack.pk@gmail.com"

# ---------------------------------------------------------------
# Runtime secrets for the Pages Function (functions/api/contact.ts).
# These are NOT read from .env. In production add them in the Cloudflare
# dashboard (mark the keys as "Secret"). For local testing copy
# .dev.vars.example to .dev.vars (also gitignored).
# ---------------------------------------------------------------
# TURNSTILE_SECRET_KEY=""
# RESEND_API_KEY=""
# CONTACT_TO_EMAIL="brightstack.pk@gmail.com"
# CONTACT_FROM_EMAIL="Brightstack Website <website@brightstack.pk>"
