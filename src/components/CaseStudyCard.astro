---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Client type, e.g. "Accountancy firm". */
  client: string;
  location?: string;
  /** One-line, plain-language result. */
  result: string;
  image: ImageMetadata;
  imageAlt: string;
  href: string;
  /** Heading level for the result line: 2 when the card sits directly under the page h1. */
  headingLevel?: 2 | 3;
  /** Load the image immediately (for cards that can appear on the first screen). */
  eager?: boolean;
}
const { client, location, result, image, imageAlt, href, headingLevel = 3, eager = false } = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
---

<a class="case-card spotlight" href={href}>
  <div class="case-card__media">
    <Image
      src={image}
      alt={imageAlt}
      widths={[400, 800]}
      sizes="(min-width: 900px) 380px, (min-width: 640px) 50vw, 100vw"
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
    />
  </div>
  <div class="case-card__body">
    <p class="case-card__client">
      {client}{location && <span> &middot; {location}</span>}
    </p>
    <Heading class="case-card__result">{result}</Heading>
    <span class="case-card__more">
      View case study <span class="nudge" aria-hidden="true">&rarr;</span>
    </span>
  </div>
</a>

<style>
  /* No height:100%: grid/flex parents stretch the card to fill its cell. */
  .case-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    /* No overflow:hidden here: it would clip the spotlight glow on the border.
       The image area clips itself instead. */
    transition: transform var(--dur-base) var(--ease-out-expo), border-color var(--dur-base) ease, box-shadow var(--dur-base) var(--ease-out-expo);
  }
  .case-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 48px -28px rgb(0 0 0 / 0.45);
    border-color: var(--brand-violet);
  }
  .case-card__media {
    aspect-ratio: 16 / 10;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    border-radius: calc(var(--radius-lg) - 1px) calc(var(--radius-lg) - 1px) 0 0;
    overflow: hidden;
  }
  .case-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-out-expo);
  }
  /* Slow, gentle zoom on the preview when the card is hovered (or in view on touch). */
  @media (hover: hover) {
    .case-card:hover .case-card__media :global(img) {
      transform: scale(1.045);
    }
  }
  .case-card:global(.in-view) .case-card__media :global(img) {
    transform: scale(1.03);
  }
  .case-card__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px 24px 24px;
    flex: 1;
  }
  .case-card__client {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
  }
  .case-card__client span {
    color: var(--muted);
    font-weight: 500;
  }
  .case-card__result {
    margin: 0;
    font-size: clamp(19px, 2vw, 22px);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .case-card__more {
    margin-top: auto;
    padding-top: 6px;
    color: var(--text);
    font-weight: 600;
    font-size: 16px;
  }
</style>
