---
interface Props {
  class?: string;
  /** Add a subtle top border to separate sections. */
  bordered?: boolean;
  id?: string;
}
const { class: className = '', bordered = false, id } = Astro.props;
---

<section id={id} class:list={['section', { 'section--bordered': bordered }, className]}>
  <div class="container">
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: clamp(48px, 8vw, 96px);
  }
  .section--bordered {
    border-top: 1px solid var(--border);
  }
</style>
