---
export type IconName =
  | 'ai'
  | 'apps'
  | 'social'
  | 'spark'
  | 'chat'
  | 'check'
  | 'search'
  | 'clipboard'
  | 'clock'
  | 'megaphone'
  | 'tag'
  | 'key'
  | 'globe'
  | 'mail';

interface Props {
  name: IconName;
  /** Accessible label; omit for purely decorative tiles. */
  label?: string;
  size?: 'md' | 'lg';
  class?: string;
}
const { name, label, size = 'md', class: className = '' } = Astro.props;
---

<span
  class:list={['icon-tile', `icon-tile--${size}`, className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  {/* Stroke uses the shared #bs-icon-grad defined once in BaseLayout. */}
  <svg viewBox="0 0 24 24" fill="none" stroke="url(#bs-icon-grad)" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
    {name === 'ai' && (
      <>
        <rect x="5" y="5" width="14" height="14" rx="3.5" />
        <path d="M9 5V2.8M15 5V2.8M9 21.2V19M15 21.2V19M5 9H2.8M5 15H2.8M21.2 9H19M21.2 15H19" />
        <text x="12" y="14.4" text-anchor="middle" font-size="6.2" font-weight="700" fill="url(#bs-icon-grad)" stroke="none" font-family="Outfit, sans-serif">AI</text>
      </>
    )}
    {name === 'apps' && (
      <>
        <rect x="2.5" y="5" width="13" height="9" rx="1.6" />
        <path d="M2.5 16.5h13" />
        <rect x="15" y="9.5" width="6.5" height="11" rx="1.8" />
        <path d="M17.6 18.2h1.3" />
      </>
    )}
    {name === 'social' && (
      <>
        <path d="M4 20V14M9 20V10M14 20v-4M19 20V9" />
        <path d="M4 10.5l5-4 5 3.5 6-6M20 4h-3.5M20 4v3.5" />
      </>
    )}
    {name === 'spark' && (
      <path d="M12 2.5l2.3 6.6L21 11l-6.7 1.9L12 19l-2.3-6.1L3 11l6.7-1.9z" />
    )}
    {name === 'chat' && <path d="M4 5h16v11H9l-5 4V5z" />}
    {name === 'check' && <path d="M4 12.5l5 5 11-11" />}
    {name === 'search' && (
      <>
        <circle cx="10.5" cy="10.5" r="6.5" />
        <path d="M15.5 15.5L21 21" />
      </>
    )}
    {name === 'clipboard' && (
      <>
        <rect x="5" y="4" width="14" height="17" rx="2.5" />
        <path d="M9 4V2.8h6V4M8.5 10h7M8.5 14h7M8.5 18h4" />
      </>
    )}
    {name === 'clock' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7v5l3.5 2" />
      </>
    )}
    {name === 'megaphone' && (
      <>
        <path d="M3 10v4a1 1 0 0 0 1 1h2l6 4V5L6 9H4a1 1 0 0 0-1 1z" />
        <path d="M16 9a4 4 0 0 1 0 6M18.5 6.5a7.5 7.5 0 0 1 0 11" />
      </>
    )}
    {name === 'tag' && (
      <>
        <path d="M3 12V4a1 1 0 0 1 1-1h8l9 9-9 9-9-9z" />
        <circle cx="8" cy="8" r="1.6" />
      </>
    )}
    {name === 'key' && (
      <>
        <circle cx="8" cy="15" r="4.5" />
        <path d="M11.2 11.8L20 3M16.5 6.5l2.5 2.5M14 9l2 2" />
      </>
    )}
    {name === 'mail' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2.5" />
        <path d="M3.5 6.5l8.5 6.5 8.5-6.5" />
      </>
    )}
    {name === 'globe' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" />
      </>
    )}
  </svg>
</span>

<style>
  .icon-tile {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    border-radius: 16px;
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .icon-tile--md {
    width: 54px;
    height: 54px;
  }
  .icon-tile--lg {
    width: 64px;
    height: 64px;
    border-radius: 18px;
  }
  .icon-tile svg {
    width: 56%;
    height: 56%;
  }
  /* Soft brand glow around the tile, like the launch-post tiles. A plain
     box-shadow: no extra layers (there are many tiles) and no blur filter.
     It sits outside the tile, never behind nearby text. */
  .icon-tile {
    box-shadow:
      0 0 18px -4px color-mix(in srgb, var(--brand-blue) 45%, transparent),
      0 0 28px -8px color-mix(in srgb, var(--brand-violet) 35%, transparent);
    transition: box-shadow var(--dur-base) var(--ease-out-expo);
  }
  /* Glow brightens when its card is hovered (or in view on touch). */
  @media (hover: hover) {
    :global(.spotlight:hover) .icon-tile {
      box-shadow:
        0 0 22px -2px color-mix(in srgb, var(--brand-blue) 70%, transparent),
        0 0 34px -6px color-mix(in srgb, var(--brand-violet) 55%, transparent);
    }
  }
  :global(.spotlight.in-view) .icon-tile {
    box-shadow:
      0 0 22px -3px color-mix(in srgb, var(--brand-blue) 60%, transparent),
      0 0 34px -7px color-mix(in srgb, var(--brand-violet) 45%, transparent);
  }
</style>
