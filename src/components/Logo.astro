---
interface Props {
  /** Show the brand mark alongside the wordmark. */
  mark?: boolean;
  class?: string;
}
const { mark = true, class: className = '' } = Astro.props;
---

<a href="/" class:list={['logo', className]} aria-label="Brightstack — home">
  {
    mark && (
      <img
        src="/brand/logo-mark.svg"
        alt=""
        width="30"
        height="30"
        class="logo__mark"
        loading="eager"
        decoding="async"
      />
    )
  }
  <span class="logo__word" aria-hidden="true">
    <span class="logo__bright">bright</span><span class="logo__stack">stack</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 44px;
  }
  .logo__mark {
    width: 30px;
    height: 30px;
    flex: none;
  }
  .logo__word {
    font-family: var(--font-heading);
    font-size: 22px;
    letter-spacing: -0.02em;
    line-height: 1;
    text-transform: lowercase;
  }
  .logo__bright {
    font-weight: 700;
  }
  .logo__stack {
    font-weight: 400;
  }
</style>
