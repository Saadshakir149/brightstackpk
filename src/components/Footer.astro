---
import Logo from '@components/Logo.astro';
import Flag from '@components/Flag.astro';
import {
  FOOTER_LINKS,
  SITE_TAGLINE,
  EMAIL,
  WHATSAPP_URL,
  SOCIALS,
} from '@config';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <Logo />
      <p class="site-footer__tag">{SITE_TAGLINE}</p>
      <p class="site-footer__serving">
        Serving businesses in{' '}
        <span class="flag-label"><Flag country="uk" /> UK</span>{' '}
        and{' '}
        <span class="flag-label"><Flag country="pk" /> Pakistan</span>
      </p>
    </div>

    <nav class="site-footer__col" aria-label="Footer">
      <h2 class="site-footer__title">Explore</h2>
      <ul>
        {FOOTER_LINKS.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-footer__col">
      <h2 class="site-footer__title">Get in touch</h2>
      <ul>
        <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
        <li><a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer">WhatsApp us</a></li>
      </ul>
      <div class="site-footer__social">
        <a href={SOCIALS.instagram} target="_blank" rel="noopener noreferrer" aria-label="Brightstack on Instagram">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a href={SOCIALS.linkedin} target="_blank" rel="noopener noreferrer" aria-label="Brightstack on LinkedIn">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
            <path d="M6.94 5a1.94 1.94 0 1 1-3.88 0 1.94 1.94 0 0 1 3.88 0zM3.5 8.5h3V21h-3zM9 8.5h2.87v1.7h.04c.4-.76 1.38-1.56 2.84-1.56 3.04 0 3.6 2 3.6 4.6V21h-3v-5.5c0-1.31-.02-3-1.83-3-1.83 0-2.11 1.43-2.11 2.9V21H9z" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="site-footer__legal">
      <p>&copy; {year} Brightstack. All rights reserved.</p>
      <p>{SITE_TAGLINE}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding-block: 48px 32px;
  }
  .site-footer__inner {
    display: grid;
    gap: 32px;
    grid-template-columns: 1.6fr 1fr 1.2fr;
  }
  .site-footer__tag {
    color: var(--muted);
    margin: 14px 0 0;
    max-width: 30ch;
  }
  .site-footer__serving {
    color: var(--muted);
    margin: 10px 0 0;
    font-size: 15px;
    line-height: 1.8;
  }
  .flag-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }
  .site-footer__title {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
    margin: 0 0 4px;
    text-transform: none;
  }
  .site-footer__col ul {
    display: flex;
    flex-direction: column;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-footer__col a {
    color: var(--muted);
    min-height: 44px;
    overflow-wrap: anywhere;
    display: inline-flex;
    align-items: center;
  }
  .site-footer__col a:hover {
    color: var(--text);
  }
  .site-footer__social {
    display: flex;
    gap: 10px;
    margin-top: 18px;
  }
  .site-footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--muted);
  }
  .site-footer__social a:hover {
    color: var(--text);
    border-color: var(--brand-blue);
  }
  .site-footer__legal {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 14px;
  }
  .site-footer__legal p {
    margin: 0;
  }

  @media (max-width: 720px) {
    .site-footer__inner {
      grid-template-columns: 1fr 1fr;
    }
    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 460px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
