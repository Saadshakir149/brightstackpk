---
// Inline SVG flags. Windows has no flag emoji (it shows "GB"/"PK" letters),
// so we draw them. Decorative: always pair with a visible country name.
interface Props {
  country: 'uk' | 'pk';
  height?: number;
}
const { country, height = 11 } = Astro.props;
// Unique per instance so two UK flags on one page never share an id.
const clipId = `flag-uk-${Math.random().toString(36).slice(2, 8)}`;
const width = country === 'uk' ? height * 2 : Math.round(height * 1.5);
---

{
  country === 'uk' ? (
    <svg class="flag" viewBox="0 0 60 30" width={width} height={height} aria-hidden="true" focusable="false">
      <clipPath id={clipId}>
        <path d="M30 15h30v15zv15H0zH0V0zV0h30z" />
      </clipPath>
      <path d="M0 0v30h60V0z" fill="#012169" />
      <path d="M0 0l60 30m0-30L0 30" stroke="#fff" stroke-width="6" />
      <path d="M0 0l60 30m0-30L0 30" clip-path={`url(#${clipId})`} stroke="#C8102E" stroke-width="4" />
      <path d="M30 0v30M0 15h60" stroke="#fff" stroke-width="10" />
      <path d="M30 0v30M0 15h60" stroke="#C8102E" stroke-width="6" />
    </svg>
  ) : (
    <svg class="flag" viewBox="0 0 90 60" width={width} height={height} aria-hidden="true" focusable="false">
      <rect width="90" height="60" fill="#fff" />
      <rect x="22.5" width="67.5" height="60" fill="#01411C" />
      <circle cx="55" cy="31" r="17" fill="#fff" />
      <circle cx="60" cy="27" r="15" fill="#01411C" />
      <path d="M67 15.5l1.6 4.9h5.1l-4.1 3 1.6 4.9-4.2-3-4.1 3 1.6-4.9-4.2-3h5.1z" fill="#fff" />
    </svg>
  )
}

<style>
  .flag {
    flex: none;
    display: inline-block;
    border-radius: 2px;
    outline: 1px solid var(--border);
  }
</style>
