---
import { NAV_TABS } from '@config';
import { cleanPath } from '@lib/seo';

const current = cleanPath(Astro.url.pathname);
const isActive = (href: string) =>
  href === '/' ? current === '/' : current === href || current.startsWith(href + '/');

const icons: Record<string, string> = {
  Home: 'M3 11l9-8 9 8M5 9.5V21h5v-6h4v6h5V9.5',
  Services: 'M4 7h16M4 12h16M4 17h10',
  Work: 'M4 7h16v12H4zM9 7V5h6v2',
  Contact: 'M4 5h16v14H4zM4 7l8 6 8-6',
};
---

<nav class="tabbar" aria-label="Mobile">
  <ul>
    {
      NAV_TABS.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={['tabbar__link', { 'is-active': isActive(item.href) }]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={icons[item.label]} />
            </svg>
            <span>{item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .tabbar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 50;
    /* Near-solid, no backdrop-filter (see Header: cheaper scrolling on phones). */
    background: color-mix(in srgb, var(--bg) 97%, transparent);
    border-top: 1px solid var(--border);
    padding-bottom: env(safe-area-inset-bottom, 0);
    /* Stays put during page-to-page view transitions. */
    view-transition-name: tabbar;
  }
  .tabbar ul {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tabbar__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    min-height: 58px;
    padding: 6px 0;
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .tabbar__link.is-active {
    color: var(--accent);
  }

  /* Only shown on mobile; desktop uses the header nav. */
  @media (min-width: 861px) {
    .tabbar {
      display: none;
    }
  }
</style>
