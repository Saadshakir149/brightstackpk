---
interface Props {
  /** Make the whole card a link. */
  href?: string;
  /** Add a hover lift (useful for linked cards). */
  interactive?: boolean;
  class?: string;
}
const { href, interactive = Boolean(href), class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  class:list={['card', { 'card--interactive': interactive }, className]}
  href={href}
>
  <slot />
</Tag>

<style>
  .card {
    display: block;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px;
    color: inherit;
    transition: transform 150ms ease, border-color 150ms ease;
  }
  .card--interactive:hover {
    transform: translateY(-3px);
    border-color: var(--brand-blue);
  }
</style>
